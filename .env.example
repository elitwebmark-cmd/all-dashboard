# --- Windsor.ai ---
# API-ключ для REST get_data (беремо в кабінеті Windsor: https://windsor.ai → Account → API key)
WINDSOR_API_KEY=

# --- База даних (Railway Postgres) ---
# Railway підставляє це автоматично, якщо додати плагін Postgres
DATABASE_URL=

# --- HubSpot (прямий доступ для лідів/SQL у реальному часі, в обхід затримки Windsor) ---
# Private App token зі scope crm.objects.deals.read. Якщо не задано — ліди беруться з Windsor (із затримкою).
HUBSPOT_TOKEN=

# --- Захист ingestion-ендпоінта (щоб cron міг тригерити завантаження) ---
INGEST_SECRET=change-me-to-a-long-random-string

# --- Каденція та регіон ---
TZ=Europe/Kyiv
# hourly | 10min — впливає лише на розклад cron на Railway, не на код
INGEST_INTERVAL=hourly

# --- (наступні етапи) Email-розсилка ---
# RESEND_API_KEY=
